:root {
    --bg-deep: #101010;
    --bg-base: #171717;
    --bg-panel: #1f1f1f;
    --bg-muted: #252525;
    --bg-surface: #2d2d2d;
    --bg-widget: #323232;
    --bg-hover: #3c3c3c;

    --bg-lit: #454545;

    --border: #131313;
    --border-ui: #2f2f2f;
    --border-dim: #3a3a3a;
    --border-lit: #4a4a4a;

    --text: #e6e6e6;
    --text-dim: #9e9e9e;
    --text-muted: #686868;
    --text-bright: #f4f4f4;

    --context-menu-bg: #1f1f1f;
    --context-menu-item: transparent;
    --context-menu-item-hover: #3c3c3c;
    --context-menu-item-press: #2d2d2d;

    --accent: #4a9e5f;
    --accent-dark: #2c4a35;
    --accent-press: #23382a;
    --accent-muted: #3d7a4e;

    --danger: #e05a40;
    --success: #4ab870;

    --input-bg: #101010;
    --input-border: #2f2f2f;

    --danger-press: rgba(255, 80, 80, 0.35);

    --selection: #4a9e5f45;
    --drop-target: rgba(74, 158, 95, 0.06);
    --drop-overlay: rgba(74, 158, 95, 0.18);
    --drop-overlay-active: rgba(74, 158, 95, 0.55);

    --row-warning: rgba(180, 140, 40, 0.08);
    --row-error: rgba(180, 70, 70, 0.10);
    --row-critical: rgba(220, 50, 50, 0.14);

    --hairline: rgba(255, 255, 255, 0.08);
    --line-inset: rgba(0, 0, 0, 0.35);
    --line-soft: rgba(255, 255, 255, 0.07);

    --axis-x: #7A2222;
    --axis-y: #226622;
    --axis-z: #224488;
    --axis-x-hover: #CC5555;
    --axis-y-hover: #55AA55;
    --axis-z-hover: #4A80D4;

    --shadow-sm: 0px 2px 6px 0px rgba(0,0,0,0.45);
    --shadow-pop: 0px 6px 22px 0px rgba(0,0,0,0.55);
}


TabView {
    width: 100%;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 2px;
}

.tab-bar {
    flex-direction: row;
    width: 100%;
    height: 30px;
    background-color: var(--bg-muted);
    border-color: var(--border-ui);
    border-width: 1px;
}

.tab-button {
    padding: 0px 14px;
    height: 100%;
    min-width: 0px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0px;
    transition: 80ms ease-out;
}

.tab-button:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.tab-active {
    background-color: var(--bg-base);
    color: var(--text-bright);
    border-color: var(--accent);
    border-width: 1px;
}

.tab-panels {
    flex-direction: column;
    width: grow;
    flex-grow: 1;
}

.tab-panel {
    width: 100%;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

ProgressBar {
    width: 100%;
    height: 14px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: var(--accent);
    border-radius: 2px;
}

ListBox {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-width: 0px;
    border-color: var(--border-ui);
    border-radius: 2px;
    padding: 4px;
    flex-direction: column;
    gap: 2px;
}

.list-item {
    padding: 6px 10px;
    width: grow;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: transparent;
    border-width: 0px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.list-item:hover {
    background-color: var(--bg-hover);
}

.selected {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.dropdown-header {
    width: grow;
    height: 100%;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    align-items: center;
    justify-content: start;
    padding: 0px 10px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

.dropdown-header:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-lit);
}

.tooltip {
    background-color: var(--bg-deep);
    border-radius: 6px;
    padding: 5px 9px;
}

.tooltip-label {
    color: var(--text-bright);
    font-family: regular;
    font-size: 14px;
}

.picker-overlay {
    width: 100%;
    height: 100%;
    color: var(--accent);
}

Separator {
    width: 100%;
    height: 1px;
    background-color: var(--border-dim);
}

.separator-v {
    width: 1px;
    height: grow;
    min-width: 0px;
    min-height: 0px;
}

ScrollView {
    overflow: scroll;
    flex-direction: column;
    width: grow;
    height: grow;
}

.scroll-inner {
    flex-direction: column;
    width: grow;
}

.scroll-bar-track {
    width: 12px;
    flex-direction: column;
    align-items: center;
    padding: 0px 3px;
    background-color: transparent;
}

.scroll-bar-thumb {
    width: 100%;
    background-color: var(--bg-lit);
    border-radius: 3px;
}

.scroll-bar-thumb:hover {
    background-color: var(--text-muted);
}

.scroll-bar-thumb:pressed {
    background-color: var(--text-dim);
}

MenuBar {
    flex-direction: row;
    align-items: center;
    width: grow;
}

.property-value {
    flex-grow: 1;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
}

Dropdown {
    min-width: 120px;
    height: 28px;
    flex-direction: column;
}

AssetSlot {
    width: 100%;
    min-height: 60px;
    flex-direction: row;
    background-color: var(--bg-surface);
    border-width: 2px;
    border-color: var(--border-dim);
    border-style: dashed;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

AssetSlot:hover {
    border-color: var(--border-lit);
    background-color: var(--bg-hover);
}

.asset-slot-filled {
    border-style: solid;
    border-color: var(--accent);
}

.asset-slot-label {
    flex-grow: 1;
}

AssetCard {
    flex-direction: column;
    align-items: center;
    background-color: var(--bg-surface);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    padding: 10px;
    gap: 8px;
    transition: 80ms ease-out;
}

AssetCard:hover {
    background-color: var(--bg-hover);
    border-color: var(--border-lit);
}

.asset-card-name {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
}

.asset-card-type {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.asset-card-thumbnail {
    width: 48px;
    height: 48px;
    border-radius: 2px;
    background-color: var(--bg-muted);
}

#root {
    width: grow;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-base);
}

#hierarchy-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#hierarchy-scroll {
    width: 100%;
    height: grow;
}

.hierarchy-toolbar{
    width: 100%;
    border-width: 0px;
    padding: 5px;
}

#toolbar {
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-deep);
    padding: 0px 6px;
    gap: 0px;
}

#toolbar-left {
    flex-direction: row;
    align-items: center;
    gap: 0px;
    width: grow;
}

#engine-logo {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
    padding: 4px 10px;
}

#image-logo {
    width: 32px;
    height: 32px;
}

.menu-bar {
    gap: 2px;
}

.menu-bar-item {
    font-family: regular;
    font-size: 16px;
    color: var(--text-dim);
    padding: 4px 10px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
    background-color: var(--bg-deep);
    border-width: 0px;
    border-radius: 4px;
}

.menu-bar-item:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.menu-bar-item:pressed {
    background-color: var(--bg-surface);
    color: var(--text);
}

.menu-dropdown,
.dropdown-popup,
ContextMenu {
    flex-direction: column;
    min-width: 140px;
    background-color: var(--bg-deep);
    padding: 6px 6px;
    gap: 4px;
}

.menu-item,
.dropdown-option,
.context-item {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    padding: 5px 14px;
    width: grow;
    border-radius: 4px;
    transition: 60ms ease-out;
    justify-content: start;
    background-color: var(--bg-deep);
}

.menu-item:hover,
.dropdown-option:hover,
.context-item:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.menu-item:pressed,
.dropdown-option:pressed,
.context-item:pressed {
    background-color: var(--bg-lit);
    color: var(--text-bright);
}

.menu-separator {
    height: 1px;
    width: 100%;
    background-color: var(--border-dim);
}

.drag-ghost {
    flex-direction: row;
    align-items: center;
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    background-color: var(--bg-surface);
    border-width: 1px;
    border-color: var(--border-lit);
    border-radius: 4px;
    padding: 4px 10px;
}

.menu-search {
    width: grow;
    height: 26px;
    font-family: regular;
    font-size: 14px;
    selection-color: var(--selection);
    placeholder-color: var(--text-muted);
}




#workspace {
    width: 100%;
    height: grow;
    flex-direction: column;
}

#dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
}




.dock-space {
    width: 100%;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
}

.dock-side-left {
    width: 14vw;
    min-width: 160px;
    max-width: 420px;
    height: 100%;
}

.dock-center {
    width: grow;
    min-width: 320px;
    height: 100%;
}

.dock-side-right {
    width: 18vw;
    min-width: 200px;
    max-width: 480px;
    height: 100%;
}

.dock-node {
    width: grow;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-side-bottom {
    width: 100%;
    height: 22vh;
    min-height: 120px;
    max-height: 480px;
}

.dock-tab-bar {
    width: 100%;
    height: 30px;
    flex-direction: row;
    background-color: var(--bg-deep);
    gap: 0px;
}

.dock-tab-wrapper {
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    align-items: center;
    padding: 5px;
}

.dock-tab-active {
    background-color: var(--bg-panel);
    border-radius: 0px 5px 0px 5px;
}

.dock-tab-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    padding: 0px 10px;
    height: 100%;
    flex-grow: 1;
    min-width: 0px;
    overflow: hidden;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms linear;
}

.dock-tab-btn-active {
    color: var(--text-bright);
}

.dock-tab-close-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 14px;
    height: 100%;
    align-items: center;
    justify-content: center;
    transition: 60ms linear;
}

.dock-tab-close-btn:hover {
    background-color: var(--danger);
    color: var(--text);
}

.dock-tab-close-btn:pressed {
    background-color: var(--danger-press);
}

.dock-node-empty {
    align-items: center;
    justify-content: center;
}

.dock-panel {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-panel-area {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-splitter {
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.dock-splitter-h {
    width: 10px;
    height: 100%;
    cursor: resize-h;
}

.dock-splitter-v {
    width: 100%;
    height: 10px;
    cursor: resize-v;
}

.dock-grabber {
    background-color: var(--text-muted);
    border-radius: 3px;
}

.dock-grabber-h {
    width: 4px;
    height: 36px;
}

.dock-grabber-v {
    width: 36px;
    height: 4px;
}


.dock-drop-target {
    border-color: var(--accent-muted);
    border-width: 1px;
    background-color: var(--drop-target);
}

.dock-zone-center-ind {
    width: 48px;
    height: 48px;
}

.dock-zone-indicator {
    width: 40px;
    height: 40px;
    background-color: var(--drop-overlay);
    border-color: var(--accent);
    border-width: 2px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.dock-zone-indicator-active {
    background-color: var(--drop-overlay-active);
    border-color: var(--text-bright);
}

.dock-tab-wrapper:pressed {
    background-color: var(--bg-surface);
}

.dock-drop-preview {
    background-color: var(--drop-overlay);
    border-color: var(--accent);
    border-width: 2px;
    border-radius: 2px;
}

.dock-zone-indicator {
    width: 44px;
    height: 44px;
    background-color: var(--bg-surface);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 2px;
    opacity: 0.85;
}

.dock-zone-indicator-active {
    background-color: var(--accent);
    border-color: var(--accent);
    opacity: 1;
}

#viewport {
    width: grow;
    height: grow;
    flex-grow: 1;
}

#console-root {
    flex-direction: column;
    width: 100%;
    height: grow;
    background-color: var(--bg-deep);
}

#console-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 32px;
    padding: 0px 6px;
    gap: 6px;
    background-color: var(--bg-panel);
}

.console-clear-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    padding: 3px 8px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.console-clear-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.console-clear-btn:pressed {
    background-color: var(--bg-surface);
}

.console-toolbar-sep {
    width: 1px;
    height: 20px;
    background-color: var(--border-dim);
}

.console-filter-btn {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.console-filter-btn:hover {
    background-color: var(--bg-hover);
}

.console-filter-btn:pressed {
    background-color: var(--bg-surface);
}

.console-filter-icon {
    width: 14px;
    height: 14px;
}

.console-filter-count {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

#console-scroll {
    flex-direction: column;
    width: 100%;
    padding: 4px 0px;
}

.console-line {
    width: 100%;
    font-family: mono;
    font-size: 16px;
    color: var(--text-dim);
    padding: 1px 8px;
    white-space: nowrap;
    overflow: hidden;
}

.console-info {
    color: var(--text-dim);
}

.console-debug {
    color: var(--text-muted);
}

.console-trace {
    color: var(--text-muted);
}

.console-warning {
    color: #c9a24a;
}

.console-error {
    color: var(--danger);
}

.console-critical {
    color: #ff5555;
}

#inspector-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#inspector-empty {
    flex-direction: column;
    width: 100%;
    height: grow;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.inspector-empty-text {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    max-width: 240px;
    text-align: center;
    white-space: normal;
}

#inspector-scroll {
    width: 100%;
    height: grow;
}

#inspector-list {
    flex-direction: column;
    width: 100%;
    padding: 8px;
    gap: 6px;
}

.inspector-add-component {
    width: 100%;
    height: 28px;
    justify-content: center;
    gap: 6px;
    border-radius: 4px;
    background-color: var(--accent-dark);
    color: var(--text);
    transition: 60ms ease-out;
}

.inspector-add-component:hover {
    background-color: var(--accent-muted);
    color: var(--text-bright);
}

.inspector-add-component:pressed {
    background-color: var(--accent-press);
}

.inspector-entity-name {
    font-family: regular;
    font-size: 18px;
    color: var(--text-bright);
    width: 100%;
    height: 24px;
    border-width: 0px;
}

.inspector-entity-uuid {
    font-family: regular;
    font-size: 12px;
    color: var(--text-dim);
    width: 100%;
    height: auto;
    border-width: 0px;
}

IconLabel {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.icon {
    width: 16px;
    height: 16px;
}

.trailing-icon {
    width: 16px;
    height: 16px;
}

.icon-label-spacer {
    width: grow;
    min-width: 24px;
    min-height: 0px;
}

.shortcut {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
}

.collapsible-header {
    flex-direction: row;
    width: 100%;
    height: 24px;
    padding: 0px 2px;
    background-color: var(--bg-surface);
    align-items: center;
}

.collapsible-title {
    width: grow;
    height: 100%;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: var(--bg-surface);
    border-width: 0px;
    padding: 0px 6px;
    align-items: center;
    justify-content: start;
    transition: 60ms linear;
}

.collapsible-title:hover {
    color: var(--text-bright);
}

.collapsible-grip {
    width: 18px;
    height: 100%;
    color: var(--text-muted);
    transition: 60ms ease-out;
    opacity: 1;
}

.collapsible-grip:hover {
    color: var(--text-dim);
}

.collapsible-drop-slot {
    width: 100%;
    background-color: var(--accent-dark);
    border-color: var(--accent);
    border-width: 1px;
    border-style: dashed;
    border-radius: 2px;
}

.collapsible-content {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    background-color: var(--bg-muted);
    border-color: var(--border-ui);
    border-width: 1px;
    padding: 10px;
    gap: 5px;
}

.property-grid {
    flex-direction: column;
    width: 100%;
    gap: 4px;
}

.property-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 24px;
}

.property-label {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 80px;
}

.property-separator {
    width: 100%;
    height: 1px;
    background-color: var(--hairline);
}




Button {
    align-items: center;
    justify-content: center;
    padding: 5px 12px;
    background-color: var(--bg-widget);
    color: var(--text);
    border-width: 0px;
    font-family: regular;
    font-size: 14px;
    transition: 80ms ease-out;
}

Button:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

Button:pressed {
    background-color: var(--bg-surface);
}

Collapsible {
    flex-direction: column;
    width: 100%;
}

ColorPicker {
    flex-direction: column;
    width: grow;
}

TextInput {
    overflow: hidden;
    width: grow;
    min-width: 0px;
    height: 26px;
    padding: 10px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

TextInput:focus {
    border-color: var(--accent);
}

.text-input {
    selection-color: var(--selection);
    placeholder-color: var(--text-muted);
}

.drag-float {
    selection-color: var(--selection);
}

Checkbox {
    width: 16px;
    height: 16px;
    background-color: var(--input-bg);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--border-dim);
    color: var(--accent);
    transition: 80ms ease-out;
}

Checkbox:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-lit);
}

Checkbox:pressed {
    background-color: var(--input-bg);
    border-color: var(--border-lit);
}

Slider {
    width: grow;
    min-width: 0px;
    height: 16px;
    color: var(--accent);
}

.slider {
    accent-color: var(--accent);
}

Toggle {
    width: 38px;
    height: 20px;
}

.toggle {
    accent-color: var(--bg-surface);
    color: var(--text-bright);
}

.toggle-on {
    accent-color: var(--accent);
}

DragFloat {
    width: grow;
    height: 24px;
    min-width: 0px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

DragInt {
    width: grow;
    height: 24px;
    min-width: 0px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

NumberInput {
    width: grow;
    height: 26px;
    min-width: 0px;
    padding: 0px 8px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

NumberInput:focus {
    border-color: var(--accent);
}

DragFloat:hover {
    border-color: var(--border-lit);
    background-color: var(--bg-muted);
}

DragFloat:focus {
    border-color: var(--accent);
}




Vec2Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

Vec3Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

Vec4Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

.labeled-drag {
    flex-direction: row;
    align-items: center;
    width: grow;
    gap: 3px;
}

.vec-label {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    width: auto;
    height: 20px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.vec-drag {
    width: grow;
    height: 22px;
}

.vec-drag-x {
    border-color: var(--axis-x);
}

.vec-drag-y {
    border-color: var(--axis-y);
}

.vec-drag-z {
    border-color: var(--axis-z);
}

.vec-drag-x:hover {
    border-color: var(--axis-x-hover);
}

.vec-drag-y:hover {
    border-color: var(--axis-y-hover);
}

.vec-drag-z:hover {
    border-color: var(--axis-z-hover);
}




.tree-view-content{
    flex-direction: column;
    width: grow;
}

.tree-view {
    flex-direction: column;
    width: grow;
    height: auto;
    padding: 6px;
}

.tree-node {
    flex-direction: column;
    width: grow;
}

.tree-node-children {
    flex-direction: column;
    width: grow;
}

.tree-node-header {
    font-family: regular;
    font-size: 16px;
    color: var(--text);
    width: grow;
    height: 24px;
    align-items: center;
    justify-content: start;
    border-radius: 6px;
    transition: 60ms linear;
    background-color: var(--bg-panel);
}

.tree-node-header:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.tree-node-header:pressed {
    background-color: var(--bg-panel);
}

.tree-node-selected {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.drag-target {
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 2px;
}

.color-picker {
    flex-direction: column;
    width: grow;
}

.cp-swatch {
    width: grow;
    height: 24px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--line-inset);
    padding: 0px;
}

.cp-popup {
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    width: 220px;
    background-color: var(--bg-panel);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--line-soft);
}

.cp-sv-area {
    width: grow;
    height: 140px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-hue-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
}

.cp-hue-bar {
    width: grow;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-preview {
    width: 28px;
    height: 28px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--line-inset);
}

.cp-alpha-bar {
    width: grow;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-mode-row {
    flex-direction: row;
    gap: 3px;
    width: grow;
}

.cp-mode-btn {
    width: grow;
    height: 22px;
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-mode-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.cp-mode-active {
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
}

.cp-mode-active:hover {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.cp-ch-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
}

.cp-ch-lbl {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 12px;
}

.cp-ch-slider {
    width: grow;
    height: 14px;
}

.cp-ch-input {
    width: 38px;
    height: 20px;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-ch-input:focus {
    border-color: var(--accent);
}

.cp-hex-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
    display: none;
}

.cp-hex-lbl {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 8px;
}

.cp-hex-input {
    width: grow;
    height: 20px;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-hex-input:focus {
    border-color: var(--accent);
}

.settings-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.settings-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 36px;
    padding: 0px 14px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.settings-title {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
    width: grow;
}

.settings-scroll {
    width: 100%;
    height: grow;
}

.settings-content {
    flex-direction: column;
    width: 100%;
    padding: 10px;
    gap: 8px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    gap: 10px;
}

.settings-label {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: grow;
    min-width: 0px;
}

.settings-field {
    width: 180px;
    min-width: 0px;
}

.settings-help {
    width: 15px;
    height: 15px;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
    transition: 80ms ease-out;
}

.settings-help:hover {
    opacity: 1;
}

.settings-help-icon {
    width: 15px;
    height: 15px;
}

.launcher-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.launcher-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 48px;
    padding: 0px 16px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.launcher-title {
    font-family: medium;
    font-size: 18px;
    color: var(--text-bright);
    width: grow;
}

.launcher-body {
    flex-direction: column;
    width: 100%;
    height: grow;
    padding: 14px;
    gap: 8px;
}

.launcher-section {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    padding: 4px 0px;
}

.launcher-list {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-color: var(--border-ui);
    border-width: 1px;
    border-radius: 2px;
}

.launcher-list-inner {
    flex-direction: column;
    width: 100%;
    padding: 4px;
    gap: 2px;
}

.launcher-project {
    width: grow;
    justify-content: start;
    padding: 8px 12px;
    background-color: transparent;
    color: var(--text);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.launcher-project:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.launcher-new-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 8px;
}

.launcher-name-input {
    width: grow;
    min-width: 0px;
}

.launcher-create-btn {
    padding: 6px 16px;
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.launcher-create-btn:hover {
    background-color: var(--accent-muted);
}

.settings-footer {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 46px;
    padding: 0px 12px;
    gap: 8px;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.settings-footer-spacer {
    width: grow;
    height: 1px;
    min-width: 0px;
}

.settings-btn {
    padding: 6px 16px;
    background-color: var(--bg-widget);
    color: var(--text);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.settings-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.settings-btn:pressed {
    background-color: var(--bg-surface);
}

.settings-btn-primary {
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
    border-width: 1px;
}

.settings-btn-primary:hover {
    background-color: var(--accent-muted);
}

.ui-debug-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.gallery-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.gallery-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    padding: 0px 12px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.gallery-title {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.gallery-scroll {
    width: 100%;
    height: grow;
}

.gallery-content {
    flex-direction: column;
    width: 100%;
    padding: 12px;
    gap: 14px;
}

.gallery-item {
    flex-direction: column;
    width: 100%;
    gap: 5px;
}

.gallery-heading {
    font-family: regular;
    font-size: 14px;
    color: var(--accent-muted);
}

.gallery-tabview {
    height: 150px;
}

.gallery-listbox {
    height: 108px;
}

.gallery-image {
    width: 32px;
    height: 32px;
}

.floating-panel-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

#panel-hierarchy {
    gap: 2px;
    padding: 2px;
}

.floating-panel-body {
    flex-direction: column;
    width: 100%;
    height: grow;
}

.ui-debug-window {
    width: 380px;
    height: 480px;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 2px;
    overflow: hidden;
}

.ui-debug-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    padding: 0px 10px;
    gap: 8px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-title {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.ui-debug-refresh {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    padding: 3px 10px;
    border-radius: 2px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.ui-debug-refresh:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.ui-debug-body {
    width: 100%;
    height: grow;
}

.ui-debug-tree-host {
    flex-direction: column;
    width: 100%;
    padding: 4px;
}

.ui-debug-tree-pane {
    width: 100%;
    height: grow;
}

.ui-debug-detail-pane {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-details {
    flex-direction: column;
    width: 100%;
    padding: 6px 8px;
    gap: 2px;
}

.ui-debug-section {
    font-family: regular;
    font-size: 14px;
    color: var(--accent-muted);
    width: 100%;
    padding: 6px 0px 2px 0px;
}

.ui-debug-row {
    flex-direction: row;
    width: 100%;
    gap: 8px;
}

.ui-debug-key {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 110px;
}

.ui-debug-val {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    flex-grow: 1;
}

.inspector-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.inspector-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 34px;
    padding: 0px 8px;
    gap: 6px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.inspector-tool-btn {
    font-family: regular;
    font-size: 13px;
    color: var(--text-dim);
    padding: 4px 10px;
    border-radius: 3px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.inspector-tool-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.inspector-tool-btn:pressed {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.inspector-tool-spacer {
    flex-grow: 1;
    height: 1px;
}

.inspector-search {
    width: 200px;
    height: 24px;
    font-family: mono;
    font-size: 12px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 3px;
    padding: 0px 8px;
}

.inspector-body {
    flex-direction: row;
    width: 100%;
    height: grow;
}

.inspector-tree-scroll {
    width: 44%;
    height: 100%;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.inspector-tree-host {
    flex-direction: column;
    width: 100%;
    padding: 4px;
}

.inspector-style-scroll {
    width: grow;
    height: 100%;
    background-color: var(--bg-base);
}

.inspector-style {
    flex-direction: column;
    width: 100%;
    padding: 8px 10px;
    gap: 2px;
}

.inspector-empty {
    width: 100%;
    padding: 20px 8px;
}

.inspector-empty-label {
    font-family: regular;
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
    width: 100%;
}

.inspector-detail {
    flex-direction: column;
    width: 100%;
    gap: 2px;
}

.inspector-subtitle {
    font-family: medium;
    font-size: 15px;
    color: var(--accent);
    width: 100%;
    padding: 2px 0px 8px 0px;
}

.inspector-section {
    flex-direction: column;
    width: 100%;
    padding: 6px 0px 2px 0px;
    gap: 1px;
}

.inspector-section-header {
    font-family: bold;
    font-size: 11px;
    color: var(--text-muted);
    width: 100%;
    padding: 4px 0px 3px 0px;
}

.inspector-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 8px;
    padding: 2px 4px;
    border-radius: 3px;
}

.inspector-row:hover {
    background-color: var(--bg-panel);
}

.inspector-key {
    font-family: mono;
    font-size: 12px;
    color: var(--text-dim);
    width: 120px;
}

.inspector-val {
    font-family: mono;
    font-size: 12px;
    color: var(--text-bright);
    flex-grow: 1;
}

.inspector-swatch {
    width: 13px;
    height: 13px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--border-lit);
    background-color: var(--bg-widget);
}

.inspector-breadcrumb-bar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 26px;
    padding: 0px 10px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
    overflow: hidden;
}

.inspector-breadcrumb {
    font-family: mono;
    font-size: 11px;
    color: var(--text-dim);
    width: grow;
    white-space: nowrap;
}

.bm-wrap {
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 6px 0px 10px 0px;
    gap: 4px;
}

.bm-padbox {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    gap: 4px;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 3px;
}

.bm-mid {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.bm-pad {
    font-family: mono;
    font-size: 11px;
    color: var(--text-dim);
}

.bm-content {
    align-items: center;
    justify-content: center;
    padding: 8px 18px;
    background-color: var(--accent-dark);
    border-width: 1px;
    border-color: var(--accent-muted);
    border-radius: 2px;
}

.bm-content-label {
    font-family: mono;
    font-size: 12px;
    color: var(--text-bright);
}

.bm-caption {
    font-family: regular;
    font-size: 10px;
    color: var(--text-muted);
}

@media (max-width: 850px) {
    .dock-side-left {
        display: none;
    }
}

@media (max-width: 600px) {
    .dock-side-left {
        display: none;
    }

    .dock-side-right {
        display: none;
    }

}

@media (max-width: 500px) {
    #toolbar {
        height: 36px;
        padding: 0px 4px;
    }

    #engine-logo {
        padding: 3px 6px;
        font-size: 14px;
    }
}



@container (max-width: 220px) {
    .dock-tab-btn {
        padding: 0px 8px;
    }
}

@container (max-width: 130px) {
    .dock-tab-btn {
        padding: 0px 4px;
    }

    .dock-tab-close-btn {
        width: 12px;
    }
}


@container (max-width: 220px) {
    .property-row {
        flex-direction: column;
        align-items: start;
        gap: 3px;
    }

    .property-label {
        width: 100%;
        font-size: 14px;
    }

}

@container (max-width: 180px) {
    Vec3Field {
        flex-direction: column;
    }

    Vec2Field {
        flex-direction: column;
    }

    Vec4Field {
        flex-direction: column;
    }

    .labeled-drag {
        width: 100%;
    }

    .collapsible-content {
        padding: 4px;
        gap: 3px;
    }
}

@container (max-width: 130px) {
    .inspector-entity-name {
        font-size: 14px;
        padding: 3px 2px;
    }

    .collapsible-header {
        height: 22px;
        font-size: 14px;
        padding: 0px 6px;
    }

    DragFloat {
        height: 20px;
        font-size: 14px;
    }
}

.hidden {
    display: none;
}

.dimmed {
    opacity: 0.35;
}
