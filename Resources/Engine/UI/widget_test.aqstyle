:root {
    --bg-deep: #0f1118;
    --bg-base: #15171d;
    --bg-panel: #1e212a;
    --bg-muted: #22242b;
    --bg-surface: #2a2f3d;
    --bg-widget: #2f3545;
    --bg-hover: #363d50;

    --border: #1a1d25;
    --border-ui: #2f343f;
    --border-dim: #3a4150;

    --text: #edeff3;
    --text-dim: #9aa0ad;
    --text-muted: #646b79;
    --text-bright: #f8fafc;

    --accent: #3a92ff;
    --accent-dark: #1a3a6e;
    --accent-press: #0f2448;
    --accent-muted: #5a80b8;

    --danger: #e05a40;
    --success: #4ab870;

    --input-bg: #0f1118;
    --input-border: #2f343f;

    --shadow-sm: 0px 2px 6px 0px rgba(0,0,0,0.45);
    --shadow-pop: 0px 6px 22px 0px rgba(0,0,0,0.55);
}


TabView {
    width: 100%;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 2px;
}

.tab-bar {
    flex-direction: row;
    width: 100%;
    height: 30px;
    background-color: var(--bg-muted);
    border-color: var(--border-ui);
    border-width: 1px;
}

.tab-button {
    padding: 0px 14px;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0px;
    transition: 80ms ease-out;
}

.tab-button:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.tab-active {
    background-color: var(--bg-base);
    color: var(--text-bright);
    border-color: var(--accent);
    border-width: 1px;
}

.tab-panels {
    flex-direction: column;
    width: grow;
    flex-grow: 1;
}

.tab-panel {
    width: 100%;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

ProgressBar {
    width: 100%;
    height: 14px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: var(--accent);
    border-radius: 2px;
}

ListBox {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    padding: 4px;
    flex-direction: column;
    gap: 2px;
}

.list-item {
    padding: 6px 10px;
    width: grow;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: transparent;
    border-width: 0px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.list-item:hover {
    background-color: var(--bg-hover);
}

.selected {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.dropdown-header {
    width: grow;
    height: 100%;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    align-items: center;
    justify-content: start;
    padding: 0px 10px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

.dropdown-header:hover {
    background-color: var(--bg-hover);
    border-color: var(--accent-muted);
}

.tooltip {
    background-color: var(--bg-deep);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 2px;
    padding: 5px 9px;
    box-shadow: var(--shadow-pop);
}

.tooltip-label {
    color: var(--text-bright);
    font-family: regular;
    font-size: 14px;
}

.picker-overlay {
    width: 100%;
    height: 100%;
    color: var(--accent);
}

Separator {
    width: 100%;
    height: 1px;
    background-color: var(--border-dim);
}

.separator-v {
    width: 1px;
    height: grow;
    min-width: 0px;
    min-height: 0px;
}

ScrollView {
    overflow: scroll;
    flex-direction: column;
    width: grow;
    height: grow;
}

.scroll-inner {
    flex-direction: column;
    width: grow;
}

MenuBar {
    flex-direction: row;
    align-items: center;
    width: grow;
}

.property-value {
    flex-grow: 1;
}

Dropdown {
    min-width: 120px;
    height: 28px;
    flex-direction: column;
}

.dropdown-popup {
    flex-direction: column;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    box-shadow: var(--shadow-pop);
    padding: 4px 4px;
}

.dropdown-option {
    width: grow;
    padding: 6px 12px;
    color: var(--text);
}

.dropdown-option:hover {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

AssetSlot {
    width: 100%;
    min-height: 60px;
    flex-direction: row;
    background-color: var(--bg-surface);
    border-width: 2px;
    border-color: var(--border-dim);
    border-style: dashed;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

AssetSlot:hover {
    border-color: var(--accent-muted);
    background-color: var(--bg-hover);
}

.asset-slot-filled {
    border-style: solid;
    border-color: var(--accent);
}

.asset-slot-label {
    flex-grow: 1;
}

AssetCard {
    flex-direction: column;
    align-items: center;
    background-color: var(--bg-surface);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    padding: 10px;
    gap: 8px;
    box-shadow: var(--shadow-sm);
    transition: 80ms ease-out;
}

AssetCard:hover {
    background-color: var(--bg-hover);
    border-color: var(--accent-muted);
}

.asset-card-name {
    font-family: medium;
    font-size: 16px;
    color: var(--text-bright);
}

.asset-card-type {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.asset-card-thumbnail {
    width: 48px;
    height: 48px;
    border-radius: 2px;
    background-color: var(--bg-muted);
}

#root {
    width: grow;
    height: grow;
    flex-direction: column;
    background-color: var(--bg-base);
}

.hierarchy-toolbar{
    width: 100%;
    background-color:
    border-color: var(--bg-base);
    border-width: 2px;
    padding: 5px;
}

#toolbar {
    box-shadow: var(--shadow-sm);
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-widget);
    border-color: var(--border);
    border-width: 1px;
    padding: 0px 6px;
    gap: 0px;
}

#toolbar-left {
    flex-direction: row;
    align-items: center;
    gap: 0px;
    width: grow;
}

#engine-logo {
    font-family: regular;
    font-size: 16px;
    color: var(--text-bright);
    padding: 4px 10px;
}

#image-logo {
    width: 32px;
    height: 32px;
}

.menu-bar-item {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    padding: 4px 10px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.menu-bar-item:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.menu-bar-item:pressed {
    background-color: var(--bg-surface);
    color: var(--text);
}

.menu-dropdown {
    flex-direction: column;
    min-width: 140px;
    box-shadow: var(--shadow-pop);
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 2px;
    padding: 6px 6px;
    gap: 4px;
}

.menu-item {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    padding: 5px 14px;
    width: 100%;
    align-items: center;
    transition: 60ms ease-out;
}

.menu-item:hover {
    background-color: var(--accent);
    color: var(--text-bright);
}

.menu-item:pressed {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.menu-separator {
    height: 1px;
    width: 100%;
    background-color: var(--border-dim);
}




#workspace {
    width: 100%;
    height: grow;
    flex-direction: column;
}

#dock-root {
    width: 100%;
    height: grow;
    flex-direction: column;
}




.dock-space {
    width: 100%;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
}

.dock-side-left {
    width: 220px;
    height: 100%;
}

.dock-center {
    width: grow;
    height: 100%;
}

.dock-side-right {
    width: 280px;
    height: 100%;
}

.dock-node {
    width: grow;
    height: grow;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-side-bottom {
    width: 100%;
    height: 200px;
}

.dock-tab-bar {
    width: 100%;
    height: 30px;
    flex-direction: row;
    background-color: var(--bg-muted);
    border-color: var(--border);
    border-width: 1px;
    gap: 0px;
}

.dock-tab-wrapper {
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    align-items: center;
    padding: 5px;
}

.dock-tab-active {
    background-color: var(--bg-base);
    border-color: var(--accent);
    border-width: 1px;
}

.dock-tab-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    padding: 0px 10px;
    height: 100%;
    flex-grow: 1;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms linear;
}

.dock-tab-btn-active {
    color: var(--text-bright);
}

.dock-tab-close-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 14px;
    height: 100%;
    align-items: center;
    justify-content: center;
    transition: 60ms linear;
}

.dock-tab-close-btn:hover {
    background-color: var(--danger);
    color: var(--text);
}

.dock-tab-close-btn:pressed {
    background-color: rgba(255, 80, 80, 0.35);
}

.dock-node-empty {
    align-items: center;
    justify-content: center;
}

.dock-panel {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-panel-area {
    flex-direction: column;
    width: grow;
    height: grow;
    flex-grow: 1;
    background-color: var(--bg-panel);
}

.dock-splitter {
    background-color: var(--bg-base);
    transition: 80ms ease-out;
}

.dock-splitter-h {
    width: 2px;
    height: 100%;
}

.dock-splitter-v {
    width: 100%;
    height: 2px;
}

.dock-splitter:hover {
    background-color: var(--accent-muted);
}

.dock-splitter:pressed {
    background-color: var(--accent);
}


.dock-drop-target {
    border-color: var(--accent-muted);
    border-width: 1px;
    background-color: rgba(58, 146, 255, 0.04);
}

.dock-zone-center-ind {
    width: 48px;
    height: 48px;
}

.dock-zone-indicator {
    width: 40px;
    height: 40px;
    background-color: rgba(58, 146, 255, 0.18);
    border-color: var(--accent);
    border-width: 2px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    display: none;
    transition: 80ms ease-out;
}

.dock-zone-indicator-active {
    background-color: rgba(58, 146, 255, 0.55);
    border-color: var(--text-bright);
}

.dock-tab-wrapper:pressed {
    background-color: var(--bg-surface);
}

.dock-drop-preview {
    background-color: rgba(58, 146, 255, 0.18);
    border-color: var(--accent);
    border-width: 2px;
    border-radius: 2px;
}

.dock-zone-indicator {
    width: 44px;
    height: 44px;
    background-color: var(--bg-surface);
    border-color: var(--accent-muted);
    border-width: 1px;
    border-radius: 2px;
    opacity: 0.85;
}

.dock-zone-indicator-active {
    background-color: var(--accent);
    border-color: var(--accent);
    opacity: 1;
}

#viewport {
    width: grow;
    height: grow;
    flex-grow: 1;
}

#console-root {
    flex-direction: column;
    width: 100%;
    height: grow;
}

#console-toolbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 32px;
    padding: 0px 6px;
    gap: 6px;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.console-clear-btn {
    font-family: regular;
    font-size: 14px;
    color: var(--text-bright);
    padding: 3px 8px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
    transition: 60ms ease-out;
}

.console-clear-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.console-clear-btn:pressed {
    background-color: var(--bg-surface);
}

.console-toolbar-sep {
    width: 1px;
    height: 20px;
    background-color: var(--border-dim);
}

.console-filter-btn {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.console-filter-btn:hover {
    background-color: var(--bg-hover);
}

.console-filter-btn:pressed {
    background-color: var(--bg-surface);
}

.console-filter-icon {
    width: 14px;
    height: 14px;
}

.console-filter-count {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

#console-scroll {
    flex-direction: column;
    width: 100%;
}

.console-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 22px;
    padding: 0px 6px;
    gap: 6px;
    transition: 60ms ease-out;
}

.console-row-even {
    background-color: var(--bg-panel);
}

.console-row-odd {
    background-color: var(--bg-base);
}

.console-row:hover {
    background-color: var(--bg-hover);
}

.console-row-selected {
    background-color: var(--accent-press);
    border-color: var(--accent-muted);
    border-width: 1px;
}

.console-warning {
    background-color: rgba(180, 140, 40, 0.08);
}

.console-error {
    background-color: rgba(180, 70, 70, 0.10);
}

.console-critical {
    background-color: rgba(220, 50, 50, 0.14);
}

.console-row-icon {
    width: 14px;
    height: 14px;
}

.console-row-text {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    flex-grow: 1;
}

#console-divider {
    width: 100%;
    height: 1px;
    background-color: var(--border-dim);
}

#console-detail {
    flex-direction: column;
    width: 100%;
    height: 60px;
    padding: 6px 8px;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

#console-detail-text {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 100%;
}

#inspector-scroll {
    flex-direction: column;
    width: 100%;
    padding: 8px;
    gap: 6px;
}

.inspector-entity-name {
    font-family: medium;
    font-size: 18px;
    color: var(--text-bright);
    width: 100%;
    height: 24px;
    border-width: 1px;
    border-color: var(--border-dim);
}

IconLabel {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.icon {
    width: 16px;
    height: 16px;
}

.collapsible-header {
    flex-direction: row;
    width: 100%;
    height: 24px;
    padding: 0px 2px;
    background-color: var(--bg-surface);
    align-items: center;
}

.collapsible-title {
    width: grow;
    height: 100%;
    font-family: medium;
    font-size: 14px;
    color: var(--text);
    background-color: var(--bg-surface);
    border-width: 0px;
    padding: 0px 6px;
    align-items: center;
    justify-content: start;
    transition: 60ms linear;
}

.collapsible-title:hover {
    color: var(--text-bright);
}

.collapsible-grip {
    width: 18px;
    height: 100%;
    color: var(--text-muted);
    transition: 60ms ease-out;
    opacity: 1;
}

.collapsible-grip:hover {
    color: var(--text-dim);
}

.collapsible-drop-slot {
    width: 100%;
    background-color: var(--accent-dark);
    border-color: var(--accent);
    border-width: 1px;
    border-style: dashed;
    border-radius: 2px;
}

.collapsible-content {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    background-color: var(--bg-muted);
    border-color: var(--border-ui);
    border-width: 1px;
    padding: 8px;
    gap: 5px;
}




.property-grid {
    flex-direction: column;
    width: 100%;
    gap: 4px;
}

.property-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 8px;
}

.property-label {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 80px;
}

.property-separator {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
}




Button {
    align-items: center;
    justify-content: center;
    padding: 5px 12px;
    background-color: var(--bg-widget);
    color: var(--text);
    border-width: 1px;
    border-color: var(--border-ui);
    font-family: regular;
    font-size: 14px;
    transition: 80ms ease-out;
}

Button:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
    border-color: var(--accent-muted);
}

Button:pressed {
    background-color: var(--accent-press);
    border-color: var(--accent);
}

Collapsible {
    flex-direction: column;
    width: 100%;
}

ColorPicker {
    flex-direction: column;
    width: grow;
}

TextInput {
    overflow: hidden;
    width: grow;
    min-width: 0px;
    height: 26px;
    padding: 10px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

TextInput:focus {
    border-color: var(--accent);
}

.text-input {
    selection-color: #3a92ff38;
    placeholder-color: var(--text-muted);
}

.drag-float {
    selection-color: #3a92ff38;
}

Checkbox {
    width: 16px;
    height: 16px;
    background-color: var(--input-bg);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--border-dim);
    color: var(--accent);
    transition: 80ms ease-out;
}

Checkbox:hover {
    background-color: var(--bg-surface);
    border-color: var(--accent-muted);
}

Checkbox:pressed {
    background-color: var(--input-bg);
    border-color: var(--accent);
}

Slider {
    width: grow;
    min-width: 0px;
    height: 16px;
    color: var(--accent);
}

.slider {
    accent-color: var(--accent);
}

Toggle {
    width: 38px;
    height: 20px;
}

.toggle {
    accent-color: #1e2535;
    color: var(--text-bright);
}

.toggle-on {
    accent-color: var(--accent);
}

DragFloat {
    width: grow;
    height: 24px;
    min-width: 0px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

DragInt {
    width: grow;
    height: 24px;
    min-width: 0px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

NumberInput {
    width: grow;
    height: 26px;
    min-width: 0px;
    padding: 0px 8px;
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    color: var(--text);
    font-family: regular;
    font-size: 14px;
    transition: 60ms ease-out;
}

NumberInput:focus {
    border-color: var(--accent);
}

DragFloat:hover {
    border-color: var(--accent-muted);
    background-color: var(--bg-muted);
}

DragFloat:focus {
    border-color: var(--accent);
}




Vec2Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

Vec3Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

Vec4Field {
    flex-direction: row;
    gap: 4px;
    width: grow;
}

.labeled-drag {
    flex-direction: row;
    align-items: center;
    width: grow;
    gap: 3px;
}

.vec-label {
    font-family: bold;
    font-size: 14px;
    color: var(--text-bright);
    width: auto;
    height: 20px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.vec-drag {
    width: grow;
    height: 22px;
}

.vec-drag-x {
    border-color: #7A2222;
}

.vec-drag-y {
    border-color: #226622;
}

.vec-drag-z {
    border-color: #224488;
}

.vec-drag-x:hover {
    border-color: #CC5555;
}

.vec-drag-y:hover {
    border-color: #55AA55;
}

.vec-drag-z:hover {
    border-color: #4A80D4;
}




ContextMenu {
    flex-direction: column;
    box-shadow: var(--shadow-pop);
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 2px;
    padding: 5px;
    width: auto;
}

.context-item {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    width: grow;
    height: 24px;
    padding: 0px 12px;
    align-items: center;
    justify-content: start;
    border-radius: 2px;
    transition: 60ms ease-out;
}

.context-item:hover {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.context-item:pressed {
    background-color: var(--accent-press);
    color: var(--text-bright);
}

.tree-view-content{
    flex-direction: column;
    width: grow;
    gap: 2px;
}

.tree-view {
    flex-direction: column;
    width: grow;
    height: grow;
    overflow: scroll;
    padding: 6px;
}

.tree-node {
    flex-direction: column;
    width: grow;
}

.tree-node-children {
    flex-direction: column;
    width: grow;
}

.tree-node-header {
    font-family: regular;
    font-size: 16px;
    color: var(--text);
    width: grow;
    height: 24px;
    align-items: center;
    justify-content: start;
    border-radius: 2px;
    transition: 60ms linear;
    padding: 4px 4px;
}

.tree-node-header:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.tree-node-header:pressed {
    background-color: var(--bg-panel);
}

.tree-node-selected {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.drag-target {
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 2px;
}

.color-picker {
    flex-direction: column;
    width: grow;
}

.cp-swatch {
    width: grow;
    height: 24px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    padding: 0px;
}

.cp-popup {
    box-shadow: var(--shadow-pop);
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    width: 220px;
    background-color: var(--bg-panel);
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.cp-sv-area {
    width: grow;
    height: 140px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-hue-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
}

.cp-hue-bar {
    width: grow;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-preview {
    width: 28px;
    height: 28px;
    border-radius: 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
}

.cp-alpha-bar {
    width: grow;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
}

.cp-mode-row {
    flex-direction: row;
    gap: 3px;
    width: grow;
}

.cp-mode-btn {
    width: grow;
    height: 22px;
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-mode-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text);
}

.cp-mode-active {
    background-color: var(--accent-dark);
    color: var(--text-bright);
    border-color: var(--accent-muted);
}

.cp-mode-active:hover {
    background-color: var(--accent-dark);
    color: var(--text-bright);
}

.cp-ch-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
}

.cp-ch-lbl {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 12px;
}

.cp-ch-slider {
    width: grow;
    height: 14px;
}

.cp-ch-input {
    width: 38px;
    height: 20px;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-ch-input:focus {
    border-color: var(--accent);
}

.cp-hex-row {
    flex-direction: row;
    gap: 6px;
    align-items: center;
    width: grow;
    display: none;
}

.cp-hex-lbl {
    font-family: regular;
    font-size: 14px;
    color: var(--text-muted);
    width: 8px;
}

.cp-hex-input {
    width: grow;
    height: 20px;
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    background-color: var(--input-bg);
    border-width: 1px;
    border-color: var(--input-border);
    border-radius: 2px;
    transition: 60ms ease-out;
}

.cp-hex-input:focus {
    border-color: var(--accent);
}

.ui-debug-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

.gallery-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
}

.gallery-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    padding: 0px 12px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.gallery-title {
    font-family: medium;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.gallery-scroll {
    width: 100%;
    height: grow;
}

.gallery-content {
    flex-direction: column;
    width: 100%;
    padding: 12px;
    gap: 14px;
}

.gallery-item {
    flex-direction: column;
    width: 100%;
    gap: 5px;
}

.gallery-heading {
    font-family: medium;
    font-size: 14px;
    color: var(--accent-muted);
}

.gallery-tabview {
    height: 150px;
}

.gallery-listbox {
    height: 108px;
}

.gallery-image {
    width: 32px;
    height: 32px;
}

.floating-panel-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--bg-base);
}

#panel-hierarchy {
    gap: 2px;
    padding: 2px;
}

.floating-panel-body {
    flex-direction: column;
    width: 100%;
    height: grow;
}

.ui-debug-window {
    width: 380px;
    height: 480px;
    flex-direction: column;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border-dim);
    border-radius: 2px;
    box-shadow: var(--shadow-pop);
    overflow: hidden;
}

.ui-debug-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 30px;
    padding: 0px 10px;
    gap: 8px;
    background-color: var(--bg-surface);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-title {
    font-family: medium;
    font-size: 14px;
    color: var(--text-bright);
    width: grow;
}

.ui-debug-refresh {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    padding: 3px 10px;
    border-radius: 2px;
    background-color: var(--bg-widget);
    border-width: 1px;
    border-color: var(--border-ui);
    align-items: center;
    justify-content: center;
    transition: 80ms ease-out;
}

.ui-debug-refresh:hover {
    background-color: var(--bg-hover);
    color: var(--text-bright);
}

.ui-debug-body {
    width: 100%;
    height: grow;
}

.ui-debug-tree-host {
    flex-direction: column;
    width: 100%;
    padding: 4px;
}

.ui-debug-tree-pane {
    width: 100%;
    height: grow;
}

.ui-debug-detail-pane {
    width: 100%;
    height: grow;
    background-color: var(--bg-panel);
    border-color: var(--border);
    border-width: 1px;
}

.ui-debug-details {
    flex-direction: column;
    width: 100%;
    padding: 6px 8px;
    gap: 2px;
}

.ui-debug-section {
    font-family: medium;
    font-size: 14px;
    color: var(--accent-muted);
    width: 100%;
    padding: 6px 0px 2px 0px;
}

.ui-debug-row {
    flex-direction: row;
    width: 100%;
    gap: 8px;
}

.ui-debug-key {
    font-family: regular;
    font-size: 14px;
    color: var(--text-dim);
    width: 110px;
}

.ui-debug-val {
    font-family: regular;
    font-size: 14px;
    color: var(--text);
    flex-grow: 1;
}

@media (max-width: 1100px) {
    .dock-side-left {
        width: 190px;
    }

    .dock-side-right {
        width: 240px;
    }
}

@media (max-width: 850px) {
    .dock-side-left {
        display: none;
    }

    .dock-side-right {
        width: 220px;
    }

}

@media (max-width: 600px) {
    .dock-side-left {
        display: none;
    }

    .dock-side-right {
        display: none;
    }

}

@media (max-width: 500px) {
    #toolbar {
        height: 36px;
        padding: 0px 4px;
    }

    #engine-logo {
        padding: 3px 6px;
        font-size: 14px;
    }
}



@container (max-width: 220px) {
    .dock-tab-btn {
        padding: 0px 8px;
        font-size: 14px;
    }
}

@container (max-width: 100px) {
    .dock-tab-bar {
        display: none;
    }
}


@container (max-width: 220px) {
    .property-row {
        flex-direction: column;
        align-items: start;
        gap: 3px;
    }

    .property-label {
        width: 100%;
        font-size: 14px;
    }

}

@container (max-width: 180px) {
    Vec3Field {
        flex-direction: column;
    }

    Vec2Field {
        flex-direction: column;
    }

    Vec4Field {
        flex-direction: column;
    }

    .labeled-drag {
        width: 100%;
    }

    .collapsible-content {
        padding: 4px;
        gap: 3px;
    }
}

@container (max-width: 130px) {
    .inspector-entity-name {
        font-size: 14px;
        padding: 3px 2px;
    }

    .collapsible-header {
        height: 22px;
        font-size: 14px;
        padding: 0px 6px;
    }

    DragFloat {
        height: 20px;
        font-size: 14px;
    }
}

.hidden {
    display: none;
}

.dimmed {
    opacity: 0.35;
}
