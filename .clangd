CompileFlags:
  CompilationDatabase: .

---
If:
  PathMatch: .*/Aquila/Foundation/Math/.*\.(h|hpp)$
CompileFlags:
  Add:
    - -std=c++20
    - -DAQUILA_PLATFORM_WINDOWS
    - -IC:/Programming/Aquila/Engine/Include
    - -IC:/Programming/Aquila/Engine/Vendor/glm
    - -include
    - C:/Programming/Aquila/Engine/Include/BasePCH.h
